				qcom,rx_mclk_mode_muxsel = <0x33a40d8>;
				qcom,va_mclk_mode_muxsel = <0x3420000>;
				qcom,wsa_mclk_mode_muxsel = <0x33a20e0>;
			};

			rx-macro@3200000 {
				clock-names = "rx_mclk2_2x_clk";
