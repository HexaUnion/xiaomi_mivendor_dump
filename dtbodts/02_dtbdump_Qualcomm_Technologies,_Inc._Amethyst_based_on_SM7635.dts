	fragment@16 {
		target = <0xffffffff>;

		__overlay__ {

			mi_ts_clk_active {
				phandle = <0xb>;

				config {
					bias-disable;
					drive-strength = <0x4>;
					pins = "gpio2";
				};

				mux {
					function = "qup0_se0_l2";
					pins = "gpio2";
				};
			};

			mi_ts_cs_active {
				phandle = <0xc>;

				config {
					bias-disable;
					drive-strength = <0x6>;
					output-high;
					pins = "gpio3";
				};

				mux {
					function = "qup0_se0_l3";
					pins = "gpio3";
				};
			};

			mi_ts_int_active {
				phandle = <0xe>;

				config {
					bias-disable;
					input-enable;
