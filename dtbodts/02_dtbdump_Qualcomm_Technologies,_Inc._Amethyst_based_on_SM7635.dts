				mux {
					function = "gpio";
					pins = "gpio124";
				};
			};

			sih_reset_active {
				phandle = <0xc2>;

				config {
					bias-disable;
					drive-strength = <0x2>;
					output-high;
					pins = "gpio125";
				};

				mux {
					function = "gpio";
					pins = "gpio125";
				};
			};

			sih_reset_reset {
				phandle = <0xc1>;

				config {
					bias-disable;
					drive-strength = <0x2>;
					output-low;
					pins = "gpio125";
				};

				mux {
					function = "gpio";
					pins = "gpio125";
				};
			};
		};
	};

