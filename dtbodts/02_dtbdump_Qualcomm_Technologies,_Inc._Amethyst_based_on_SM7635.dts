	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			nfc {

				nfc_enable_active {
					phandle = <0x1b>;

					config {
						bias-disable;
						drive-strength = <0x2>;
						pins = "gpio7", "gpio6";
					};

					mux {
						function = "gpio";
						pins = "gpio7", "gpio6";
					};
				};

				nfc_enable_suspend {
					phandle = <0x1d>;

					config {
						bias-disable;
						drive-strength = <0x2>;
						pins = "gpio7", "gpio6";
					};

					mux {
						function = "gpio";
						pins = "gpio7", "gpio6";
					};
				};

				nfc_int_active {
					phandle = <0x1a>;

					config {
						bias-pull-down;
						drive-strength = <0x2>;
						pins = "gpio31";
					};

					mux {
						function = "gpio";
						pins = "gpio31";
					};
				};

				nfc_int_suspend {
					phandle = <0x1c>;

					config {
						bias-pull-down;
						drive-strength = <0x2>;
						pins = "gpio31";
					};

					mux {
						function = "gpio";
						pins = "gpio31";
					};
				};
			};
		};
	};

