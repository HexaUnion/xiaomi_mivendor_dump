			lpass-cdc-clk-rsc-mngr {
				clock-names = "tx_core_clk", "rx_core_clk", "wsa_core_clk", "rx_tx_core_clk", "wsa_tx_core_clk", "va_core_clk";
				clocks = <0x79 0x0 0x7a 0x0 0x7b 0x0 0x7c 0x0 0x7d 0x0 0x7e 0x0>;
				compatible = "qcom,lpass-cdc-clk-rsc-mngr";
