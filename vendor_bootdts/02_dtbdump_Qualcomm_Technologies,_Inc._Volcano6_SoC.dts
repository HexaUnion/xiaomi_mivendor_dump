			#size-cells = <0x2>;
			compatible = "mmio-sram";
			phandle = <0x2cc>;
			ranges = <0x0 0x0 0x0 0x17d09400 0x0 0x400>;
			reg = <0x0 0x17d09400 0x0 0x400>;

			scmi-shmem@0 {
