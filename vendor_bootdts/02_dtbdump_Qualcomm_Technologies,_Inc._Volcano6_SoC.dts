				qcom,tcs-offset = <0x1c00>;

				bcm_voter {
					compatible = "qcom,bcm-voter";
					phandle = <0x53>;
					qcom,tcs-wait = <0x1>;
				};

				channel@0 {
					qcom,tcs-config = <0x2 0x0 0x0 0x1 0x1 0x1 0x3 0x0 0x4 0x0>;
				};

				sde_rsc_rpmh {
					cell-index = <0x0>;
					compatible = "qcom,sde-rsc-rpmh";
				};
			};
		};

